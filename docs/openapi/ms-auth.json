{
  "openapi": "3.1.0",
  "info": {
    "title": "ms-auth",
    "description": "Usuarios, roles y login de LivesManage",
    "version": "1"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/usuarios/{id}": {
      "put": {
        "tags": [
          "usuario-controller"
        ],
        "summary": "Editar nombre, correo y rol",
        "description": "409 si el correo ya existe o si la Admin intenta cambiar su propio rol.",
        "operationId": "editar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EdicionUsuario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/api/usuarios/{id}/contrasena": {
      "put": {
        "tags": [
          "usuario-controller"
        ],
        "summary": "Restablecer la contraseña de otro usuario (D-49)",
        "description": "409 si es la propia: esa se cambia en /api/auth/contrasena.",
        "operationId": "restablecerContrasena",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevaContrasena"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/api/auth/contrasena": {
      "put": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Cambiar mi contraseña (D-49)",
        "description": "400 si la contraseña actual no coincide.",
        "operationId": "cambiarContrasena",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambioContrasena"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/api/usuarios": {
      "get": {
        "tags": [
          "usuario-controller"
        ],
        "summary": "Listar usuarios, ordenados por nombre",
        "operationId": "listar",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      },
      "post": {
        "tags": [
          "usuario-controller"
        ],
        "summary": "Crear un usuario con su contraseña inicial",
        "description": "409 si el correo ya existe.",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevoUsuario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Iniciar sesión (RF-01)",
        "description": "401 con un mensaje genérico si el correo no existe, la contraseña no coincide o el usuario está desactivado.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/usuarios/{id}/activo": {
      "patch": {
        "tags": [
          "usuario-controller"
        ],
        "summary": "Desactivar o reactivar",
        "description": "409 si la Admin intenta desactivarse a sí misma.",
        "operationId": "cambiarActivo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambioActivo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    },
    "/api/auth/yo": {
      "get": {
        "tags": [
          "auth-controller"
        ],
        "summary": "Usuario de la sesión, con sus datos al día",
        "operationId": "yo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "jwt": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EdicionUsuario": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMIN",
              "VENDEDOR"
            ]
          }
        },
        "required": [
          "correo",
          "nombre",
          "rol"
        ]
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMIN",
              "VENDEDOR"
            ]
          },
          "activo": {
            "type": "boolean"
          }
        }
      },
      "NuevaContrasena": {
        "type": "object",
        "properties": {
          "contrasena": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": [
          "contrasena"
        ]
      },
      "CambioContrasena": {
        "type": "object",
        "properties": {
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "nueva": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": [
          "actual",
          "nueva"
        ]
      },
      "NuevoUsuario": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "rol": {
            "type": "string",
            "enum": [
              "ADMIN",
              "VENDEDOR"
            ]
          },
          "contrasena": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          }
        },
        "required": [
          "contrasena",
          "correo",
          "nombre",
          "rol"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "contrasena": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "contrasena",
          "correo"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "usuario": {
            "$ref": "#/components/schemas/UsuarioDto"
          }
        }
      },
      "CambioActivo": {
        "type": "object",
        "properties": {
          "activo": {
            "type": "boolean"
          }
        },
        "required": [
          "activo"
        ]
      }
    },
    "securitySchemes": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}