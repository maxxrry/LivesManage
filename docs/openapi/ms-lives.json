  "components": {
    "schemas": {
      "CambioNoPago": {
        "type": "object",
        "properties": {
          "noPago": {
            "type": "boolean"
          }
        },
        "required": [
          "noPago"
        ]
      },
      "CambioPagoDto": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string"
          },
          "usuarioId": {
            "type": "string"
          }
        }
      },
      "LineaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sesionId": {
            "type": "string"
          },
          "clientaId": {
            "type": "string"
          },
          "clientaNombre": {
            "type": "string"
          },
          "prendas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrendaDto"
            }
          },
          "estadoPago": {
            "type": "string",
            "enum": [
              "PENDIENTE",
              "PAGADO",
              "NO_PAGO"
            ]
          },
          "pagoActualizado": {
            "$ref": "#/components/schemas/CambioPagoDto"
          },
          "bolsas": {
            "type": "integer",
            "format": "int32"
          },
          "entregada": {
            "type": "boolean"
          },
          "entregaId": {
            "type": "string"
          },
          "actualizada": {
            "type": "string"
          }
        }
      },
      "PrendaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "precio": {
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "type": "string",
            "enum": [
              "VIGENTE",
              "CANCELADA"
            ]
          }
        }
      },
      "DatosEntrega": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "DESPACHO",
              "RETIRO",
              "FERIA"
            ]
          },
          "direccion": {
            "$ref": "#/components/schemas/DireccionDto"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "DireccionDto": {
        "type": "object",
        "properties": {
          "calle": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "comuna": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "region": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "referencia": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "calle",
          "comuna"
        ]
      },
      "EntregaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sesionId": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "DESPACHO",
              "RETIRO",
              "FERIA"
            ]
          },
          "direccion": {
            "$ref": "#/components/schemas/DireccionDto"
          }
        }
      },
      "DatosBolsas": {
        "type": "object",
        "properties": {
          "bolsas": {
            "type": "integer",
            "format": "int32",
            "maximum": 99,
            "minimum": 0
          },
          "entregada": {
            "type": "boolean"
          }
        }
      },
      "NuevaSesion": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        }
      },
      "SesionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "inicio": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ABIERTA",
              "EN_CIERRE",
              "CERRADA"
            ]
          }
        }
      },
      "Destino": {
        "type": "object",
        "properties": {
          "clientaId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          "nuevaClienta": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "unoSolo": {
            "type": "boolean"
          }
        }
      },
      "NuevaAnotacion": {
        "type": "object",
        "properties": {
          "destino": {
            "$ref": "#/components/schemas/Destino"
          },
          "precios": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "maximum": 999000,
              "minimum": 1000
            },
            "maxItems": 50,
            "minItems": 0
          }
        },
        "required": [
          "destino",
          "precios"
        ]
      },
      "ResultadoAnotar": {
        "type": "object",
        "properties": {
          "anotacionId": {
            "type": "string"
          },
          "linea": {
            "$ref": "#/components/schemas/LineaDto"
          }
        }
      },
      "SesionResumenDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "inicio": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "ABIERTA",
              "EN_CIERRE",
              "CERRADA"
            ]
          },
          "clientas": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "totalPagado": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SesionDetalleDto": {
        "type": "object",
        "properties": {
          "sesion": {
            "$ref": "#/components/schemas/SesionDto"
          },
          "lineas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineaDto"
