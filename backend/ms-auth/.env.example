# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.
DB_USUARIO=livesmanage
DB_CONTRASENA=cambia-esta-contrasena
# Misma clave en el api-gateway y en todos los microservicios. Al menos 32 caracteres al azar.
JWT_SECRET=cambia-esto-por-una-clave-larga-de-al-menos-32-caracteres
# Primera Admin: solo se usa si la tabla de usuarios está vacía.
ADMIN_CORREO=admin@livesmanage.cl
ADMIN_CONTRASENA=cambia-esta-contrasena
