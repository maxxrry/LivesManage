# Para docker-compose.yml. Copia este archivo como .env en el servidor y completa los valores. Nunca subas el .env.
# Genera cada clave con: openssl rand -base64 36

# Dominio que apunta a la IP del servidor (ej: DuckDNS). Para probar en el PC: localhost
DOMINIO=livesmanage.duckdns.org

# Al menos 32 caracteres al azar. La usan el gateway y los tres servicios.
JWT_SECRET=

# Contraseña del usuario livesmanage de MySQL y la del usuario root.
DB_CONTRASENA=
MYSQL_ROOT_PASSWORD=

# Primera Admin: solo se usa si la tabla de usuarios está vacía. Contraseña de al menos 8 caracteres;
# cámbiala después desde "Cambiar mi contraseña".
ADMIN_CORREO=
ADMIN_CONTRASENA=
